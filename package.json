{
  "name": "jkt48-manager-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "localization:audit": "node scripts/localization-audit.mjs",
    "db:migrate:local": "wrangler d1 migrations apply gacha-jkt48 --local",
    "db:migrate:remote": "wrangler d1 migrations apply gacha-jkt48 --remote",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev",
    "pages:deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
